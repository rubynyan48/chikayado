# httpとwwwのアクセスを https://ちか宿.jp にまとめる
RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://xn--u8j0b149r.jp/$1 [R=301,L]

# 以前のイベントの詳しいページはイベントのページへまとめた
RewriteRule ^(tokyo-big-sight/[^/]+)/guide/?$ /$1/ [R=301,L]

# 外した会場（ポートメッセなごや）のページはトップへ
RedirectMatch 301 ^/portmesse-nagoya(/.*)?$ https://xn--u8j0b149r.jp/

ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
